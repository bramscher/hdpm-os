{
  "name": "hdpm-dez-operator",
  "version": "0.1.0",
  "private": true,
  "description": "Dez AppFolio operator worker — headless Playwright automation for web-app-only actions (form-merge). Deployed separately to Railway; called by the HDPM-OS Dez agent over a signed contract. NOT part of the Vercel/Next app.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "register-passkey": "tsx src/register-passkey.ts",
    "test-login": "tsx src/test-login.ts",
    "debug-login": "tsx src/debug-login.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
