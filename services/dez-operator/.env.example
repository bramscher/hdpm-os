# hdpm-dez-operator — Railway env (all secret; never commit real values)

# Shared secret for the HMAC contract with Dez (must match DEZ_OPERATOR_SECRET in the Vercel app).
OPERATOR_SHARED_SECRET=

# Hard on/off at the service. Set to "false" to make the worker return 503.
OPERATOR_ENABLED=true

# AppFolio operator seat (dez@). 2FA is a PASSKEY the worker owns — AppFolio has
# no authenticator-app (TOTP) option, only SMS or passkeys.
APPFOLIO_BASE_URL=https://highdesertpm.appfolio.com
APPFOLIO_DEZ_USER=dez@highdesertpm.com
APPFOLIO_DEZ_PASSWORD=
# The worker's passkey credential — base64 of the JSON from `npm run register-passkey`.
# (Portable: not tied to any device or keychain. See src/register-passkey.ts.)
APPFOLIO_DEZ_PASSKEY=

# Persisted AppFolio session (point at a Railway volume mount).
APPFOLIO_STORAGE_STATE=/data/storageState.json

PORT=8080
